{
  "manifest_version": 2,
  "name": "QuickConfigS",
  "description": "An extension to quickly map out QuickBase table dbid's, field names and field IDs.",
  "version": "0.1.2",
  
  "background": {
    "scripts": ["js/service_worker_firefox.js"],
    "persistent": false
  },
  
  "browser_action": {
    "default_icon": { "19": "images/logo.png" },
    "default_title": "QuickConfigS",
    "default_popup": "index.html"
  },
  
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "tabs",
    "https://*.quickbase.com/*",
    "<all_urls>"
  ],
  
  "applications": {
    "gecko": {
      "id": "quickconfigs@example.com",
      "strict_min_version": "57.0"
    }
  }
}
